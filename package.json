{
  "name": "firebase-to-supabase",
  "version": "1.0.0",
  "description": "firebase-to-supabase",
  "homepage": "https://github.com/Bash4195/firebase-to-supabase#readme",
  "bugs": {
    "url": "https://github.com/Bash4195/firebase-to-supabase/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bash4195/firebase-to-supabase.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "firebase:auth:export:dev": "firebase auth:export ./auth/users-dev.json --format=json --project dev-flavorish",
    "firebase:auth:export:staging": "firebase auth:export ./auth/users-staging.json --format=json --project staging-flavorish",
    "firebase:auth:export:production": "firebase auth:export ./auth/users-production.json --format=json --project production-flavorish",
    "backfill:auth:dev": "env-cmd -f .env.development npx ts-node ./auth/import_users.ts ./auth/users-dev.json 20",
    "backfill:auth:staging": "env-cmd -f .env.staging npx ts-node ./auth/import_users.ts ./auth/users-staging.json 20",
    "backfill:auth:production": "env-cmd -f .env.production npx ts-node ./auth/import_users.ts ./auth/users-production.json 20"
  },
  "devDependencies": {
    "@types/node": "^25.6.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "@types/uuid": "^10.0.0",
    "env-cmd": "^11.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "uuid": "^14.0.0"
  }
}
